{
  "name": "what-is-my-speed",
  "version": "0.0.4",
  "description": "Self-hosted multi-profile, multi-server speed monitor powered by the Ookla Speedtest CLI",
  "main": "src/server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "DATA_DIR=./data node --watch --disable-warning=ExperimentalWarning src/server.js",
    "screenshots": "node scripts/screenshots.mjs",
    "demo:seed": "node --disable-warning=ExperimentalWarning scripts/demo-seed.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "chart.js": "4.4.7"
  },
  "license": "MIT",
  "devDependencies": {
    "puppeteer-core": "^23.11.1"
  }
}
